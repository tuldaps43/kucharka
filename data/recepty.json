      },
      {
        "text": "Nechat vařit asi 15 minut",
        "casovac_min": null
      },
      {
        "text": "Po dochucení omáčky vyndat kardamom, bobkový list, badyán a skořici",
        "casovac_min": null
      },
      {
        "text": "Do mísy nasypat mouku s kypřícím ppráškem a trochu osolit",
        "casovac_min": null
      },
      {
        "text": "Přilít smetanu",
        "casovac_min": null
      },
      {
